# ==============================================================================
# VisionX AI — Environment Variable Template
# Firebase configuration is managed in `firebase-applet-config.json`.
# Never commit `.env` or real secrets.
# ==============================================================================

# Frontend / Backend API & WebSocket endpoints (for Phase 2+ Python FastAPI workers)
VITE_API_BASE_URL="http://localhost:8000/api/v1"
VITE_WS_BASE_URL="ws://localhost:8000/ws"

# Backend (FastAPI — Server-side ONLY; never prefix with VITE_)
APP_ENV="development"
APP_NAME="VisionX AI API"
API_HOST="0.0.0.0"
API_PORT="8000"
LOG_LEVEL="INFO"
CORS_ORIGINS="http://localhost:3000"

# Object Storage & Future AI/Biometric Phases
OBJECT_STORAGE_DRIVER="local"
OBJECT_STORAGE_LOCAL_DIR="./storage"
BIOMETRIC_MASTER_KEY_B64=""
GEMINI_API_KEY=""
